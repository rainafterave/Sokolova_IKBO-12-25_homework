start: declaration* value
?value: NUMBER -> number
      | STRING -> string
      | dictionary
      | expression
dictionary: "begin" (declaration | pair)* "end"
pair: NAME ":=" value ";"
declaration: "set" NAME "=" value
expression: "^(" item+ ")"
?item: value
     | INTEGER -> number
     | NAME -> reference
     | OP -> operation
INTEGER: /[0-9]+/
OP: "+" | "sqrt()" | "pow()" | "sqrt" | "pow"
NAME: /[A-Z]+/
NUMBER: /[0-9]+\.[0-9]*/
STRING: /"(?:[^"\\\x00-\x1f]|\\["\\\/bfnrt]|\\u[0-9a-fA-F]{4})*"/
COMMENT: /#=(?s:.*?)=#/
%import common.WS
%ignore WS
%ignore COMMENT
